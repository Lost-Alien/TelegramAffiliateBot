# Telegram API credentials from https://my.telegram.org/apps
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Optional: Phone number for automated login prompt
PHONE_NUMBER=+910000000000

# Session file name
SESSION_NAME=userbot_session

# Amazon Affiliate Tag
AFFILIATE_TAG=techselect-20

# Default Amazon Domain (e.g. amazon.com, amazon.in, amazon.co.uk)
AMAZON_DOMAIN=amazon.com

# Source Channels (Comma-separated channel usernames or IDs to monitor, e.g., @dealbee,@rapiddeals)
# Leave empty to monitor ALL joined channels/groups
SOURCE_CHANNELS=

# Target Channels (Comma-separated channel usernames or IDs to post converted deals to, e.g., @my_deal_channel)
TARGET_CHANNELS=@my_deal_channel

# Log level
LOG_LEVEL=INFO
