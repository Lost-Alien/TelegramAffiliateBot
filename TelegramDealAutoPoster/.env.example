# Telegram API credentials from https://my.telegram.org/apps
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Optional: Phone number for automated login prompt
PHONE_NUMBER=+91XXXXXXXXXX

# Session file name
SESSION_NAME=userbot_session

# Amazon Affiliate Tags (comma-separated, rotates automatically)
AFFILIATE_TAGS=yourtag-20,yourtag2-20

# Default Amazon Domain
AMAZON_DOMAIN=amazon.in

# ── Channel Configuration ──────────────────────────────────────────

# Source Channels to monitor (comma-separated @usernames or IDs; leave empty = all joined)
SOURCE_CHANNELS=

# Target Channel(s) to publish converted deals to (comma-separated @usernames or numeric IDs)
TARGET_CHANNELS=-100XXXXXXXXXX

# ── Safety / Operational Knobs ─────────────────────────────────────

# Silent monitoring period (hours) — no posts, only logging. Helps burner accounts warm up.
WARMUP_HOURS=24

# Max concurrent posts per rolling hour; random delay range between posts (seconds).
RATE_LIMIT_HR=10
MIN_DELAY_S=30
MAX_DELAY_S=90

# Chat ID to receive failure/alert notifications (fallback: first target channel). Leave empty to disable.
ALERT_CHAT_ID=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Web UI Monitor Configuration (binds localhost only; for remote access use a reverse proxy with auth)
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Website Integration
WEBSITE_WEBHOOK_URL=http://localhost:3000/api/deals
WEBSITE_WEBHOOK_SECRET=your_secret_token_here_change_this

# ── X (Twitter) Deal Post Format ───────────────────────────────────
# DEAL_FORMAT_STYLE: "pricehawk" (default) or "loot_sale" (legacy)
#   pricehawk = single link, price anchoring, max 2 hashtags (higher reach)
#   loot_sale = old MEGA LOOT SALE 💥 header with 5 hashtags (backward compat)
DEAL_FORMAT_STYLE=pricehawk

# DEAL_POSTING_MODE: "two_step" (default, PriceHawk method) or "single_tweet"
#   two_step    = Step1: hook tweet (no link, full algorithm reach)
#                 Step2: XActions auto-reply with affiliate link 2 seconds later
#   single_tweet = posts everything in one tweet (legacy behaviour)
DEAL_POSTING_MODE=two_step

# Hashtags used in tweet reply (default: "#TechDeals #Ad" — keeps reply clean)
# Override to add more, but keep <=2 to avoid X spam suppression
DEAL_HASHTAGS=#TechDeals #Ad

# Max chars for product name extracted from Telegram message (default: 80)
DEAL_PRODUCT_MAX_LEN=80
