# Telegram Bot API Token from @BotFather
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Amazon Affiliate Tag (e.g., mystore-20 or mystore-21)
AFFILIATE_TAG=your_affiliate_tag_here
# Optional: comma-separated list of tags to rotate through
AFFILIATE_TAGS=your_first_tag,your_second_tag

# Amazon Base Domain (e.g., amazon.com, amazon.in, amazon.es, amazon.co.uk)
AMAZON_DOMAIN=amazon.in

# Optional: Channel to auto-post converted links to (numeric ID like -100..., or @username)
CHANNEL_ID=

# Optional: Source channel to watch for Amazon links (bot must be an admin there)
SOURCE_CHANNEL_ID=

# Your website, shown in bot messages and post buttons
WEBSITE_URL=https://techselect.blog/

# Optional: Telegram Chat ID of Developer to receive error alerts
DEV_CHAT_ID=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
